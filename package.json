{
  "name": "qrup",
  "version": "0.2.0",
  "type": "module",
  "description": "QRUp - Simple file upload page for local network",
  "main": "dist/server.js",
  "scripts": {
    "build": "bun run build:client && bun run build:server",
    "build:client": "vite build",
    "build:server": "bun build server/index.ts --target=bun --outfile=dist/server.js",
    "build:binary": "bun run build:client && bun scripts/build-binary.ts",
    "start": "bun run build && bun dist/server.js",
    "dev": "concurrently -n client,server \"vite build --watch\" \"bun --watch server/index.ts\"",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "bun run typecheck && bun run lint",
    "test:e2e": "playwright test --reporter=line",
    "test:e2e:ui": "playwright test --ui",
    "test:ci": "playwright test",
    "changelog": "changelogen",
    "release": "bun run check && bun run build && changelogen --release"
  },
  "keywords": [
    "upload",
    "file-transfer",
    "local-network",
    "qr-code"
  ],
  "author": "Tobias Trusch",
  "repository": {
    "type": "git",
    "url": "https://github.com/totherush/qrup.git"
  },
  "license": "MIT",
  "dependencies": {
    "archiver": "^8.0.0",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/archiver": "^8.0.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "changelogen": "^0.6.2",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "bun": ">=1.3",
    "node": ">=24"
  }
}
